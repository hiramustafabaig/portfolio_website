---
import Layout from "../layouts/Layout.astro";
import { projects } from "../data/projects";

const statusColor: Record<string, string> = {
  Live: "text-blue-mist border-blue-mist/40",
  "In Progress": "text-accent-soft border-accent/40",
  Research: "text-accent-gold border-accent-gold/40",
};
---

<Layout
  title="Projects"
  description="AI-powered platforms, research prototypes, and full-stack systems built by Hira Baig."
  path="/projects"
>
  <section class="mx-auto max-w-5xl px-6 py-16">
    <p class="reveal font-display text-sm uppercase tracking-[0.3em] text-accent-soft">Work</p>
    <h1 class="reveal mt-3 font-display text-4xl font-bold text-text sm:text-5xl">
      Projects &amp; <span class="text-gradient-dusk">Systems</span>
    </h1>
    <p class="reveal mt-4 max-w-2xl text-text-muted">
      From research prototypes to production-facing platforms — the common thread is testing whether an
      idea holds up once real users and messy data get involved.
    </p>

    <div class="mt-12 space-y-6">
      {projects.map((p, i) => (
        <article id={p.slug} class="reveal glass scroll-mt-28 rounded-2xl p-6 sm:p-8" style={`transition-delay:${i * 80}ms`}>
          <div class="flex flex-col gap-6 sm:flex-row sm:items-start">
            {p.image && (
              <img
                src={p.image}
                alt={p.title}
                width="160"
                height="160"
                loading="lazy"
                class="h-28 w-28 flex-shrink-0 rounded-xl object-cover sm:h-32 sm:w-32"
              />
            )}
            <div class="flex-1">
              <div class="flex flex-wrap items-center gap-3">
                <h2 class="font-display text-2xl font-semibold text-text">{p.title}</h2>
                <span class={`rounded-full border px-2.5 py-0.5 text-xs ${statusColor[p.status]}`}>
                  {p.status}
                </span>
              </div>
              <p class="mt-3 text-sm leading-relaxed text-text-muted sm:text-base">{p.description}</p>
              <div class="mt-4 flex flex-wrap gap-2">
                {p.tech.map((t) => (
                  <span class="rounded-full border border-border bg-surface-2/50 px-3 py-1 text-xs text-text-muted">
                    {t}
                  </span>
                ))}
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>
</Layout>
