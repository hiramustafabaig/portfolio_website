---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Thank You" description="Message received." path="/thank-you">
  <section class="mx-auto flex min-h-[50vh] max-w-2xl flex-col items-center justify-center px-6 text-center">
    <h1 class="font-display text-3xl font-bold text-text sm:text-4xl">
      Thanks for reaching out<span class="text-gradient-dusk">.</span>
    </h1>
    <p class="mt-4 text-text-muted">I'll get back to you as soon as I can.</p>
    <a
      href="/"
      class="mt-8 rounded-full bg-accent px-7 py-3 font-medium text-void transition-all hover:-translate-y-0.5 hover:bg-accent-soft"
    >
      Back Home
    </a>
  </section>
</Layout>
