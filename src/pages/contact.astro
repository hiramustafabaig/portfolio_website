---
import Layout from "../layouts/Layout.astro";
import { profile } from "../data/profile";
---

<Layout
  title="Contact"
  description="Get in touch with Hira Baig for research collaboration, projects, or opportunities."
  path="/contact"
>
  <section class="mx-auto max-w-2xl px-6 py-16">
    <p class="reveal font-display text-sm uppercase tracking-[0.3em] text-accent-soft">Contact</p>
    <h1 class="reveal mt-3 font-display text-4xl font-bold text-text sm:text-5xl">
      Let's <span class="text-gradient-dusk">talk</span>
    </h1>
    <p class="reveal mt-4 text-text-muted">
      Research collaboration, project ideas, or opportunities — send a message and I'll get back to you.
    </p>

    <form
      name="contact"
      method="POST"
      data-netlify="true"
      netlify-honeypot="bot-field"
      action="/thank-you"
      class="reveal glass mt-10 space-y-5 rounded-2xl p-6 sm:p-8"
    >
      <input type="hidden" name="form-name" value="contact" />
      <p class="hidden">
        <label>Don't fill this out: <input name="bot-field" /></label>
      </p>

      <div>
        <label for="name" class="mb-1.5 block text-sm font-medium text-text">Name</label>
        <input
          id="name"
          name="name"
          type="text"
          required
          class="w-full rounded-lg border border-border bg-surface-2/60 px-4 py-2.5 text-text placeholder:text-text-dim focus:border-accent focus:outline-none"
          placeholder="Your name"
        />
      </div>

      <div>
        <label for="email" class="mb-1.5 block text-sm font-medium text-text">Email</label>
        <input
          id="email"
          name="email"
          type="email"
          required
          class="w-full rounded-lg border border-border bg-surface-2/60 px-4 py-2.5 text-text placeholder:text-text-dim focus:border-accent focus:outline-none"
          placeholder="you@example.com"
        />
      </div>

      <div>
        <label for="message" class="mb-1.5 block text-sm font-medium text-text">Message</label>
        <textarea
          id="message"
          name="message"
          rows="5"
          required
          class="w-full rounded-lg border border-border bg-surface-2/60 px-4 py-2.5 text-text placeholder:text-text-dim focus:border-accent focus:outline-none"
          placeholder="What would you like to talk about?"
        ></textarea>
      </div>

      <button
        type="submit"
        class="w-full rounded-full bg-accent px-7 py-3 font-medium text-void transition-all hover:-translate-y-0.5 hover:bg-accent-soft sm:w-auto"
      >
        Send Message
      </button>
    </form>

    <p class="reveal mt-8 text-sm text-text-dim">
      Prefer email? Reach me directly at
      <a href={`mailto:${profile.email}`} class="text-accent-soft underline underline-offset-4 hover:text-accent">
        {profile.email}
      </a>
    </p>
  </section>
</Layout>
