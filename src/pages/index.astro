---
import Layout from "../layouts/Layout.astro";
import Hero3D from "../components/Hero3D";
import { profile, coreValues } from "../data/profile";
import { skillGroups } from "../data/skills";
import { projects } from "../data/projects";
---

<Layout
  title="Hira Baig"
  description="Data Scientist & AI/ML Engineer building trustworthy, explainable AI systems — from published research to production platforms."
  path="/"
>
  <!-- Hero -->
  <section class="relative flex min-h-[85vh] items-center overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0"
      style="background: linear-gradient(180deg, #1c2440 0%, #16223a 28%, #0d1728 55%, #0a1220 100%);"
    >
    </div>
    <div
      class="pointer-events-none absolute -right-24 bottom-0 h-[26rem] w-[26rem] rounded-full opacity-70 blur-3xl sm:h-[32rem] sm:w-[32rem]"
      style="background: radial-gradient(circle, rgba(255,183,110,0.35) 0%, rgba(255,183,110,0) 70%);"
    >
    </div>
    <Hero3D client:only="react" />
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-bg via-transparent to-transparent"></div>

    <div class="relative z-10 mx-auto max-w-5xl px-6 py-24 text-center">
      <p class="reveal mb-4 font-display text-sm uppercase tracking-[0.3em] text-accent-soft">
        {profile.role}
      </p>
      <h1 class="reveal font-display text-5xl font-bold leading-[1.05] tracking-tight text-text sm:text-6xl md:text-7xl">
        Hi, I'm <span class="text-gradient-dusk">Hira Baig</span>
      </h1>
      <p class="reveal mx-auto mt-6 max-w-2xl text-lg text-text-muted sm:text-xl">
        {profile.tagline}
      </p>
      <div class="reveal mt-10 flex flex-wrap items-center justify-center gap-4">
        <a
          href="/projects"
          class="rounded-full bg-accent px-7 py-3 font-medium text-void shadow-lg shadow-accent/20 transition-all hover:-translate-y-0.5 hover:bg-accent-soft hover:shadow-accent/30"
        >
          View Projects
        </a>
        <a
          href="/contact"
          class="glass rounded-full px-7 py-3 font-medium text-text transition-all hover:-translate-y-0.5"
        >
          Get in Touch
        </a>
      </div>
    </div>

    <div class="absolute bottom-8 left-1/2 z-10 -translate-x-1/2 animate-bounce text-text-dim">
      <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
      </svg>
    </div>
  </section>

  <!-- Skills -->
  <section class="mx-auto max-w-5xl px-6 py-24">
    <div class="reveal mb-12 text-center">
      <h2 class="font-display text-3xl font-bold text-text sm:text-4xl">
        Skills &amp; <span class="text-gradient-dusk">Expertise</span>
      </h2>
    </div>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {skillGroups.map((group, i) => (
        <div
          class="reveal glass rounded-2xl p-6"
          style={`transition-delay: ${i * 80}ms`}
        >
          <h3 class="font-display text-sm font-semibold uppercase tracking-wide text-accent-soft">
            {group.category}
          </h3>
          <ul class="mt-4 flex flex-wrap gap-2">
            {group.items.map((item) => (
              <li class="rounded-full border border-border bg-surface-2/50 px-3 py-1 text-xs text-text-muted">
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- Featured Projects -->
  <section class="mx-auto max-w-5xl px-6 py-24">
    <div class="reveal mb-12 flex items-end justify-between">
      <h2 class="font-display text-3xl font-bold text-text sm:text-4xl">
        Featured <span class="text-gradient-dusk">Work</span>
      </h2>
      <a href="/projects" class="hidden text-sm font-medium text-accent-soft hover:text-accent sm:block">
        View all &rarr;
      </a>
    </div>
    <div class="grid gap-6 sm:grid-cols-2">
      {projects.filter((p) => p.featured).map((p, i) => (
        <a
          href={`/projects#${p.slug}`}
          class="reveal glass group relative overflow-hidden rounded-2xl p-6 transition-transform hover:-translate-y-1"
          style={`transition-delay: ${i * 80}ms`}
        >
          <div class="flex items-start justify-between">
            <h3 class="font-display text-xl font-semibold text-text">{p.title}</h3>
            <span class="rounded-full border border-border px-2 py-0.5 text-xs text-text-dim">{p.status}</span>
          </div>
          <p class="mt-3 text-sm text-text-muted">{p.blurb}</p>
          <div class="mt-4 flex flex-wrap gap-2">
            {p.tech.slice(0, 4).map((t) => (
              <span class="text-xs text-accent-soft">{t}</span>
            ))}
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Core Values -->
  <section class="mx-auto max-w-5xl px-6 py-24">
    <div class="reveal mb-12 text-center">
      <h2 class="font-display text-3xl font-bold text-text sm:text-4xl">
        How I <span class="text-gradient-dusk">Work</span>
      </h2>
    </div>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {coreValues.map((v, i) => (
        <div class="reveal glass rounded-2xl p-6 text-center" style={`transition-delay: ${i * 80}ms`}>
          <div class="mx-auto flex h-10 w-10 items-center justify-center rounded-full border border-accent/30 text-lg text-accent">
            {v.icon}
          </div>
          <h3 class="mt-4 font-display text-sm font-semibold text-text">{v.name}</h3>
          <p class="mt-2 text-xs leading-relaxed text-text-muted">{v.description}</p>
        </div>
      ))}
    </div>
  </section>
</Layout>
