---
import Layout from "../layouts/Layout.astro";
import { blogs } from "../data/blogs";
---

<Layout title="Blogs" description="Writing on data science, AI, and computing by Hira Baig." path="/blogs">
  <section class="mx-auto max-w-5xl px-6 py-16">
    <p class="reveal font-display text-sm uppercase tracking-[0.3em] text-accent-soft">Writing</p>
    <h1 class="reveal mt-3 font-display text-4xl font-bold text-text sm:text-5xl">
      Blogs &amp; <span class="text-gradient-dusk">Articles</span>
    </h1>

    <div class="mt-12 grid gap-6 sm:grid-cols-2">
      {blogs.map((b, i) => (
        <a
          href={b.href}
          target="_blank"
          rel="noopener noreferrer"
          class="reveal glass group overflow-hidden rounded-2xl transition-transform hover:-translate-y-1"
          style={`transition-delay:${i * 80}ms`}
        >
          {b.image && <img src={b.image} alt={b.title} loading="lazy" class="h-40 w-full object-cover" />}
          <div class="p-6">
            <h2 class="font-display text-lg font-semibold text-text group-hover:text-accent-soft">{b.title}</h2>
            <p class="mt-2 text-sm text-text-muted">{b.description}</p>
            <span class="mt-4 inline-block text-xs font-medium text-accent-soft">Read PDF &rarr;</span>
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>
