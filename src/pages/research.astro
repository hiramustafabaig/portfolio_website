---
import Layout from "../layouts/Layout.astro";
import { publications, researchInterests } from "../data/research";
---

<Layout
  title="Research"
  description="Publications and research interests: trustworthy, explainable machine learning for healthcare and real-world deployment."
  path="/research"
>
  <section class="mx-auto max-w-3xl px-6 py-16">
    <p class="reveal font-display text-sm uppercase tracking-[0.3em] text-accent-soft">Research</p>
    <h1 class="reveal mt-3 font-display text-4xl font-bold text-text sm:text-5xl">
      Making AI systems <span class="text-gradient-dusk">trustworthy</span>
    </h1>
    <p class="reveal mt-4 text-text-muted">
      My research centers on one question: what makes an intelligent system dependable once the conditions
      it operates under are far less controlled than the ones it was trained and evaluated on.
    </p>

    <div class="reveal mt-8 flex flex-wrap gap-2">
      {researchInterests.map((r) => (
        <span class="rounded-full border border-accent/30 bg-accent/5 px-3 py-1.5 text-sm text-accent-soft">
          {r}
        </span>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-6 py-8">
    <h2 class="reveal font-display text-2xl font-bold text-text sm:text-3xl">Publications</h2>
    <div class="mt-8 space-y-5">
      {publications.map((pub, i) => (
        <div class="reveal glass rounded-2xl p-6" style={`transition-delay:${i * 80}ms`}>
          <div class="flex items-start justify-between gap-4">
            <h3 class="font-display text-lg font-semibold leading-snug text-text">{pub.title}</h3>
            <span
              class:list={[
                "flex-shrink-0 rounded-full border px-2.5 py-0.5 text-xs",
                pub.status === "Published"
                  ? "border-blue-mist/40 text-blue-mist"
                  : "border-accent-gold/40 text-accent-gold",
              ]}
            >
              {pub.status}
            </span>
          </div>
          <p class="mt-2 text-sm text-text-muted">{pub.authors}</p>
          <p class="mt-1 text-sm text-text-dim">{pub.venue} · {pub.year}</p>
        </div>
      ))}
    </div>
  </section>
</Layout>
