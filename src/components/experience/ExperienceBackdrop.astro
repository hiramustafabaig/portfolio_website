---
/**
 * Pure CSS + SVG decorative backdrop for the Experience section — no JS,
 * no hydration, no WebGL. Renders synchronously with the page so it can
 * never fail to show up the way a client-side React/Three.js island can.
 * A handful of hand-authored flowing threads with a traveling "energy"
 * dash animation, plus a couple of slow-drifting glow blobs and a faint
 * dot grid for texture. Masked so it fades out over the heading/copy on
 * the left and stays out of the way of the cards below.
 */
---

<div class="exp-backdrop" aria-hidden="true">
  <div class="exp-backdrop__dots"></div>
  <div class="exp-backdrop__glow exp-backdrop__glow--a"></div>
  <div class="exp-backdrop__glow exp-backdrop__glow--b"></div>
  <svg class="exp-backdrop__lines" viewBox="0 0 1200 600" preserveAspectRatio="none" fill="none">
    <path class="exp-line exp-line--1" d="M 200,80 C 450,40 650,160 820,110 S 1150,60 1260,140" />
    <path class="exp-line exp-line--2" d="M 150,220 C 400,260 600,150 850,220 S 1150,300 1300,250" />
    <path class="exp-line exp-line--3" d="M 300,420 C 500,380 700,470 900,410 S 1180,450 1300,400" />
    <path class="exp-line exp-line--4" d="M 250,520 C 480,560 680,480 920,540 S 1200,560 1320,520" />
    <path class="exp-line exp-line--5" d="M 500,20 C 600,120 700,60 780,180 S 900,320 850,420" />
    <circle class="exp-node exp-node--1" cx="820" cy="110" r="4" />
    <circle class="exp-node exp-node--2" cx="850" cy="220" r="3" />
    <circle class="exp-node exp-node--3" cx="900" cy="410" r="3.5" />
    <circle class="exp-node exp-node--4" cx="780" cy="180" r="3" />
    <circle class="exp-node exp-node--5" cx="1150" cy="60" r="2.5" />
  </svg>
</div>

<style>
  .exp-backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, rgba(0, 0, 0, 0.5) 28%, black 55%);
    mask-image: linear-gradient(90deg, transparent 0%, rgba(0, 0, 0, 0.5) 28%, black 55%);
  }

  .exp-backdrop__dots {
    position: absolute;
    inset: -10% -10%;
    opacity: 0.35;
    background-image: radial-gradient(circle, color-mix(in srgb, var(--color-pale) 45%, transparent) 1px, transparent 1.5px);
    background-size: 34px 34px;
  }

  .exp-backdrop__glow {
    position: absolute;
    border-radius: 9999px;
    filter: blur(70px);
    opacity: 0.5;
  }
  .exp-backdrop__glow--a {
    right: -8%;
    top: -15%;
    height: 55%;
    width: 40%;
    background: radial-gradient(circle, #9c2c3d66, transparent 70%);
    animation: exp-drift-a 22s ease-in-out infinite;
  }
  .exp-backdrop__glow--b {
    right: 8%;
    bottom: -20%;
    height: 60%;
    width: 45%;
    background: radial-gradient(circle, #c9a22740, transparent 70%);
    animation: exp-drift-b 26s ease-in-out infinite;
  }

  .exp-backdrop__lines {
    position: absolute;
    inset: 0;
    height: 100%;
    width: 100%;
  }

  .exp-line {
    fill: none;
    stroke-linecap: round;
  }
  .exp-line--1 {
    stroke: #e8d8c4;
    stroke-width: 1.4;
    opacity: 0.4;
    stroke-dasharray: 10 14;
    animation: exp-flow 14s linear infinite;
  }
  .exp-line--2 {
    stroke: #a68a76;
    stroke-width: 1;
    opacity: 0.3;
    stroke-dasharray: 6 16;
    animation: exp-flow 18s linear infinite reverse;
  }
  .exp-line--3 {
    stroke: #9c2c3d;
    stroke-width: 1.6;
    opacity: 0.35;
    stroke-dasharray: 8 18;
    animation: exp-flow 16s linear infinite;
  }
  .exp-line--4 {
    stroke: #e8d8c4;
    stroke-width: 1;
    opacity: 0.25;
    stroke-dasharray: 4 20;
    animation: exp-flow 20s linear infinite reverse;
  }
  .exp-line--5 {
    stroke: #c9a227;
    stroke-width: 1.2;
    opacity: 0.3;
    stroke-dasharray: 5 22;
    animation: exp-flow 24s linear infinite;
  }

  .exp-node {
    fill: #e8d8c4;
    opacity: 0.5;
    animation: exp-pulse 5s ease-in-out infinite;
  }
  .exp-node--1 { animation-delay: 0s; fill: #9c2c3d; }
  .exp-node--2 { animation-delay: 1.1s; }
  .exp-node--3 { animation-delay: 2.2s; fill: #c9a227; }
  .exp-node--4 { animation-delay: 0.6s; }
  .exp-node--5 { animation-delay: 1.8s; }

  @keyframes exp-flow {
    to { stroke-dashoffset: -240; }
  }
  @keyframes exp-pulse {
    0%, 100% { opacity: 0.25; transform: scale(1); }
    50% { opacity: 0.85; transform: scale(1.6); }
  }
  @keyframes exp-drift-a {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(-4%, 3%) scale(1.08); }
  }
  @keyframes exp-drift-b {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(3%, -4%) scale(1.05); }
  }

  @media (prefers-reduced-motion: reduce) {
    .exp-line,
    .exp-node,
    .exp-backdrop__glow {
      animation: none !important;
    }
  }
</style>
